# Telegraph testnet
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_WS_URL=wss://devnode.telegraphprotocol.com/engine/ws
# Required in production after registration. Use the active numeric ID from
# https://devnode.telegraphprotocol.com/api/miners/<registrationId>.
TELEGRAPH_MINER_ID=

# Wallet used for x402 payments and WebSocket auth
EVM_PRIVATE_KEY=0x...
EVM_WALLET_ADDRESS=0x...

# Data provider keys (for DegenMiner)
ALCHEMY_KEY=
STRICT_MODE=true
# Keep this below the hosting and Telegraph proxy timeout.
REQUEST_TIMEOUT_S=8.0
ETHERSCAN_KEY=
BASESCAN_KEY=
SOLSCAN_KEY=
COINGECKO_KEY=

# LLM for AI chat / market pulse
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
