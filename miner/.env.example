# DegenMiner configuration.
#
# Copy to `.env` in this directory (packages/miner/.env) for local development.
# `.env` is gitignored — never commit real keys.
#
# For production, set these as Railway variables instead:
#   railway variables --set ALCHEMY_KEY=your_key_here

# ── Required for live chain data ─────────────────────────────────────────────
# Without this the miner CANNOT observe chain state. It falls back to the
# deterministic demo feed and labels every response data_source="demo".
# Get one free at https://dashboard.alchemy.com — create an app on Ethereum
# Mainnet and copy the API key (just the key, not the full URL).
ALCHEMY_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# CoinGecko's free tier works with no key. Supplying a Pro key raises rate
# limits. https://www.coingecko.com/en/api/pricing
COINGECKO_KEY=

# Refuse to serve synthetic data at all. Recommended TRUE in production: a
# registered miner serving invented figures gets graded against real ground
# truth, which destroys the Canonical Score.
# Keep false only for local development. Production must refuse synthetic data.
STRICT_MODE=true

# ── Tuning (defaults are sensible; override only if needed) ──────────────────
# PRICE_TTL=60                  # token price cache, seconds
# STATS_TTL=300                 # transfer query cache, seconds
# UPSTREAM_TIMEOUT_S=12.0       # per-request upstream timeout
# MAX_UPSTREAM_CONCURRENCY=12   # cap on simultaneous RPC calls
# REQUEST_TIMEOUT_S=8.0         # return structured unavailable before proxy timeout
# CIRCUIT_THRESHOLD=5           # consecutive failures before breaker opens
# CIRCUIT_COOLDOWN_S=30.0       # how long the breaker stays open
