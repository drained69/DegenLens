# Telegraph testnet
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_WS_URL=wss://devnode.telegraphprotocol.com/engine/ws
# Required in production after registration. Use the active numeric ID from
# https://devnode.telegraphprotocol.com/api/miners/<registrationId>.
# Where the co-located DegenMiner listens. Sentinel's discovery step calls it
# directly, so an unreachable value fails every scan with "discovery failed:
# fetch failed" and the agent silently scans nothing.
LOCAL_MINER_URL=http://localhost:8787
TELEGRAPH_MINER_ID=

# Wallet used for x402 payments and WebSocket auth
EVM_PRIVATE_KEY=0x...
EVM_WALLET_ADDRESS=0x...

# Data provider keys (for DegenMiner)
ALCHEMY_KEY=
STRICT_MODE=true
# Keep this below the hosting and Telegraph proxy timeout.
REQUEST_TIMEOUT_S=8.0
ETHERSCAN_KEY=
BASESCAN_KEY=
SOLSCAN_KEY=
COINGECKO_KEY=

# LLM for AI chat / market pulse
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentinel — autonomous watch agent (Track 3 layer)
# Master switch; the scheduler also stops when interval is 0.
SENTINEL_ENABLED=true
# Minutes between scheduled scans (default 30). 0 disables the schedule.
SENTINEL_INTERVAL_MINUTES=30
# Flow lookback window per operator scan.
SENTINEL_WINDOW_HOURS=24
# Minimum observed withdrawal volume (USD) before flow findings can fire.
SENTINEL_MIN_USD=5000
# Per operator+rule alert cooldown.
SENTINEL_COOLDOWN_MINUTES=120
# Operators whose flow stats are read per cycle.
SENTINEL_MAX_OPERATORS=6
# Hot/treasury wallets balance-checked per cycle (rotating) — each check is a
# paid WALLET_BALANCE_CHECK request through the engine.
SENTINEL_MAX_WALLETS=8
# Prior balance (native units) below which a drop is not a finding.
SENTINEL_BALANCE_FLOOR=5
# Paid FRAUD_DETECTION screens per alerting operator.
SENTINEL_MAX_FRAUD_SCREENS=1
# Paid ONCHAIN_TX_LOOKUP calls per alert, on tx hashes the fraud screen cites.
SENTINEL_MAX_TX_LOOKUPS=2
# Alerts escalated to other miners per scan (news/sentiment/fact-check).
SENTINEL_MAX_ESCALATIONS=2
# auto = escalate high-severity only; always; never.
SENTINEL_ESCALATE=auto
# Where scan/alert/receipt state persists (defaults to .sentinel-state.json).
SENTINEL_STATE_PATH=
